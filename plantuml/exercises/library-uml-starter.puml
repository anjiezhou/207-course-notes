@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' Your task (Chapter 8, Question 1): draw the UML class diagram for the library
' specification — items, books, DVDs, reference-only items, members, librarians,
' and holds.
'
' Define each type as a box, then connect them with the right arrows. One box
' (Item) is filled in as an example — decide on the rest yourself. There is more
' than one defensible answer.
'
' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface
' (Putting the parent/interface on the LEFT of the arrow keeps it on top, which
'  is the convention used in these notes.)

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

abstract class BorrowableItem {
  - {static} loadPeriod : Period
  - onHoldMemberNumbersQueue : Queue<Integer>
  - currentOnLoanMemberNumber : Integer
  + getLoadPeriod() : Period
  + getOnHoldMemberNumbersQueue() : Queue<Integer>
  + getCurrentOnLoanMemberNumber() : Integer
}

class BorrowableBook {
}

class BorrowableDVD {
}

abstract class ReferenceOnlyItem {
}

class ReferenceOnlyBook {
}

class ReferenceOnlyDVD {
}

abstract class People {
}

class Librarian {
  + waveLateFee(member : Member) : boolean
  + addItemToCatalog(item : Item) : boolean
}

class Member {
  - memberNumber : int
  - fee : BigDecimal
  - onLoanItems : Set<Item>
  + getMemberNumber() : int
  + getFee() : BigDecimal
  + getOnLoanItems() : Set<Item>
  + logIn() : boolean
  + placeHold(item : Item) : boolean
}

class Library {
  - catalog : Set<Item>
  - people : Set<People>
  + getCatalog() : Set<Item>
  + getPeople() : Set<People>
  + borrow(item : Item, member : Member) : boolean
}

' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface

Library <--o Item
Library <--o People
Item <|-- BorrowableItem
Item <|-- ReferenceOnlyItem
BorrowableItem <|-- BorrowableBook
BorrowableItem <|-- BorrowableDVD
ReferenceOnlyItem <|-- ReferenceOnlyBook
ReferenceOnlyItem <|-- ReferenceOnlyDVD
People <|-- Member
People <|-- Librarian

