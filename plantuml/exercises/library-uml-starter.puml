@startuml Entities
skinparam dpi 96
skinparam classAttributeIconSize 0
hide empty members
hide methods

' Your task (Chapter 8, Question 1): draw the UML class diagram for the library
' specification — items, books, DVDs, reference-only items, members, librarians,
' and holds.
'
' Define each type as a box, then connect them with the right arrows. One box
' (Item) is filled in as an example — decide on the rest yourself. There is more
' than one defensible answer.
'
' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface
' (Putting the parent/interface on the LEFT of the arrow keeps it on top, which
'  is the convention used in these notes.)

package "Entities Layer" {

  package "High-level entities" {

    abstract class Item {
      - title : String
      - catalogueNumber : String
      - borrowPolicy : LoanPolicy
      - holdPolicy : HoldPolicy
      + getTitle() : String
      + getCatalogueNumber() : String
      + getBorrowPolicy() : LoanPolicy
      + getHoldPolicy() : HoldPolicy
    }

    interface LoanPolicy {
      + isBorrowable() : boolean
    }

    interface BorrowablePolicy {
      + isOnLoan() : boolean
      + getLoanPeriod() : Period
      + getCurrentOnLoanMemberNumber() : Integer
      + setCurrentOnLoanMemberNumber(memberEntity : MemberEntity) : boolean
    }

    interface HoldPolicy {
      + isHoldable() : boolean
    }

    interface HoldablePolicy {
      + getOnHoldMemberNumber() : Integer
      + setOnHoldMemberNumber(memberEntity : MemberEntity) : boolean
    }

    interface ReferenceOnlyPolicy {
    }

    abstract class BookEntity {
    }

    abstract class DvdEntity {
    }

    abstract class People {
      + idNumber : int
      + getIdNumber() : int
    }

    abstract class LibrarianEntity {
    }

    abstract class MemberEntity {
      - fee : BigDecimal
      - onLoanItems : Set<Item>
      + getFee() : BigDecimal
      + getOnLoanItems() : Set<Item>
      + addLoanItem(item : Item) : boolean
      + setFee(newFee : BigDecimal) : boolean
    }

    abstract class LibraryEntity {
      - catalog : Set<Item>
      - people : Set<People>
      + getCatalog() : Set<Item>
      + getPeople() : Set<People>
    }

  }

  package "Lower-level implementations" {

    class Borrowable {
      - loanPeriod : Period
      - currentOnLoanMemberNumber : Integer
    }

    class Holdable {
      - onHoldMemberNumber : Integer
    }

    class Librarian {
    }

    class Member {
    }

    class Library {
    }

    class Book {
    }

    class Dvd {
    }
  }

  Item <--o LibraryEntity
  People <--o LibraryEntity
  LibraryEntity <|-- Library
  Item <|-- BookEntity
  Item <|-- DvdEntity
  BookEntity <|-- Book
  DvdEntity <|-- Dvd
  LoanPolicy <--* Item
  LoanPolicy <|.. BorrowablePolicy
  LoanPolicy <|.. ReferenceOnlyPolicy
  BorrowablePolicy <|.. Borrowable
  HoldPolicy <--* Item
  HoldPolicy <|.. HoldablePolicy
  HoldablePolicy <|.. Holdable
  People <|-- MemberEntity
  People <|-- LibrarianEntity
  LibrarianEntity <|-- Librarian
  MemberEntity <|-- Member
}

@enduml

@startuml UseCases
hide methods

skinparam dpi 96
skinparam classAttributeIconSize 0
hide empty members

package "Entities Layer (referenced)" {
  abstract class Item
  abstract class People
  abstract class LibraryEntity
  abstract class MemberEntity
  abstract class LibrarianEntity
}

package "Use Cases Layer" {

  class PlaceHoldInteractor {
    + placeHold(libraryEntity : LibraryEntity, item : Item) : boolean
  }

  class LogInInteractor {
    + logIn(libraryEntity : LibraryEntity, people : People) : boolean
  }

  class BorrowInteractor {
    + borrowRequest(libraryEntity : LibraryEntity, item : Item, memberEntity : MemberEntity) : boolean
  }

  class AddItemToCatalogInteractor {
    + addItemToCatalog(libraryEntity : LibraryEntity, item : Item) : boolean
  }

  class WaveLateFeeInteractor {
    + waveLateFee(libraryEntity : LibraryEntity, memberEntity : MemberEntity) : boolean
  }

  Item <-- PlaceHoldInteractor
  LibrarianEntity <-- PlaceHoldInteractor

  LibraryEntity <-- LogInInteractor
  People <-- LogInInteractor

  LibraryEntity <-- BorrowInteractor
  Item <-- BorrowInteractor
  MemberEntity <-- BorrowInteractor

  LibraryEntity <-- AddItemToCatalogInteractor
  Item <-- AddItemToCatalogInteractor

  LibraryEntity <-- WaveLateFeeInteractor
  MemberEntity <-- WaveLateFeeInteractor
}


